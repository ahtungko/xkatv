{
  "name": "xkaTV",
  "private": true,
  "version": "1.1.0",
  "description": "xkaTV · 你的私人流媒体影院",
  "author": "ahtungko",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahtungko/xkatv.git"
  },
  "bugs": {
    "url": "https://github.com/ahtungko/xkatv/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "prebuild": "pnpm --filter @xkatv/cms-core build && pnpm check:api-types",
    "check:api-types": "node scripts/check-api-types.mjs",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:analyze": "pnpm run prebuild && tsc --noEmit && vite build --manifest --outDir .generated/bundle-analysis && pnpm analyze:bundle",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "build:cf": "pnpm run prebuild && vite build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
