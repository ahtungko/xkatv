    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cors": "^2.8.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "express": "^4.22.3",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
